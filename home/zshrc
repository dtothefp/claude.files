#!/usr/bin/env zsh
# ~/.zshrc  (symlinked from this dotfiles repo)
# Fast zsh stack: antidote (plugin manager) + Starship (prompt).
# Replaces Oh My Zsh. Machine-local secrets stay out of the repo.

# ---------------------------------------------------------------------------
# Homebrew (Apple Silicon). Idempotent; also set in ~/.zprofile for login shells.
# ---------------------------------------------------------------------------
eval "$(/opt/homebrew/bin/brew shellenv)"

# ---------------------------------------------------------------------------
# Machine-local secrets and per-machine overrides. NEVER committed.
# Copy secrets/zsh_secrets.example to ~/.zsh_secrets and fill in real values.
# ---------------------------------------------------------------------------
[[ -f ~/.zsh_secrets ]] && source ~/.zsh_secrets

# ---------------------------------------------------------------------------
# History
# ---------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt SHARE_HISTORY INC_APPEND_HISTORY EXTENDED_HISTORY

# ---------------------------------------------------------------------------
# Shell options
# ---------------------------------------------------------------------------
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS INTERACTIVE_COMMENTS

# ---------------------------------------------------------------------------
# Completion (init once, cache for speed)
# ---------------------------------------------------------------------------
autoload -Uz compinit
# Rebuild the dump at most once a day, otherwise load the cached one (-C).
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive

# ---------------------------------------------------------------------------
# antidote, the plugin manager (replaces oh-my-zsh.sh)
# Plugin list: ~/.zsh_plugins.txt. A static bundle is regenerated only when
# the list changes, so startup just sources one flat file.
# ---------------------------------------------------------------------------
antidote_home="$(brew --prefix antidote 2>/dev/null)/share/antidote"
if [[ -f "$antidote_home/antidote.zsh" ]]; then
  source "$antidote_home/antidote.zsh"
  zsh_plugins_txt=~/.zsh_plugins.txt
  zsh_plugins_zsh=~/.zsh_plugins.zsh
  if [[ ! "$zsh_plugins_zsh" -nt "$zsh_plugins_txt" ]]; then
    antidote bundle <"$zsh_plugins_txt" >"$zsh_plugins_zsh"
  fi
  source "$zsh_plugins_zsh"
fi

# ---------------------------------------------------------------------------
# Keybindings. Force the emacs keymap. Oh My Zsh used to do this for us; without
# it, zsh picks the keymap from $EDITOR (now 'nvim', which contains "vi") and
# silently boots into vi-insert, where Ctrl-P / Ctrl-N self-insert as a literal
# ^P / ^N instead of walking history. -e restores the classic readline keys
# (Ctrl-A/E/P/N/R/W ...), matching the old OMZ behavior.
# ---------------------------------------------------------------------------
bindkey -e

# zsh-history-substring-search: wire Up/Down and Ctrl-P/Ctrl-N to prefix-aware
# history search. Must run AFTER the plugin is sourced above (the widgets are
# defined there). On an empty line these behave like plain history up/down
# (parity with the old setup); with a typed prefix they cycle only matching
# commands. Both ^[[A and ^[OA are bound to cover normal and application-cursor
# mode (the latter is what tmux sends).
bindkey '^[[A' history-substring-search-up      # Up arrow (normal)
bindkey '^[OA' history-substring-search-up      # Up arrow (application/tmux)
bindkey '^[[B' history-substring-search-down    # Down arrow (normal)
bindkey '^[OB' history-substring-search-down    # Down arrow (application/tmux)
bindkey '^P'   history-substring-search-up      # Ctrl-P
bindkey '^N'   history-substring-search-down    # Ctrl-N

# ---------------------------------------------------------------------------
# Modular config: aliases, exports, functions (symlinked to ~/.config/zsh)
# ---------------------------------------------------------------------------
for f in ~/.config/zsh/*.zsh(N); do
  source "$f"
done

# ---------------------------------------------------------------------------
# Prompt: Starship (replaces the oh-my-zsh robbyrussell theme)
# ---------------------------------------------------------------------------
command -v starship >/dev/null && eval "$(starship init zsh)"

# ---------------------------------------------------------------------------
# Modern CLI tool init
# ---------------------------------------------------------------------------
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"       # smart cd, z
command -v fzf    >/dev/null && source <(fzf --zsh) 2>/dev/null  # Ctrl-R / Ctrl-T / Alt-C
