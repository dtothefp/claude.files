# zsh_secrets.example
# Copy to ~/.zsh_secrets, fill in real values, then: chmod 600 ~/.zsh_secrets
# ~/.zshrc sources ~/.zsh_secrets if it exists. This file is a TEMPLATE only.
# NEVER put real values in the repo. ~/.zsh_secrets is git-ignored by living
# outside the repo (it is in $HOME, not here).

# --- API tokens ---------------------------------------------------------
export YOUTUBE_DATA_API_KEY=""
export APIFY_TOKEN=""
export TF_TOKEN_app_terraform_io=""
export NGROK_AUTHTOKEN=""

# --- AWS (set the profile/account you actually need in this shell) -------
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_DEFAULT_REGION="us-west-2"

# --- RDS (staging) ------------------------------------------------------
export RDS_ENDPOINT=""
export RDS_USER=""
export RDS_PASSWORD=""
export RDS_DATABASE=""
